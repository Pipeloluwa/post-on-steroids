{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "post-on-steroids": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor",
                "output": "/assets/monaco/"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.prod.ts" },
                { "replace": "src/environments/edition.ts", "with": "src/environments/edition.enterprise.ts" }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": false
              }
            },
            "community": {
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.prod.ts" },
                { "replace": "src/environments/edition.ts", "with": "src/environments/edition.community.ts" }
              ],
              "budgets": [
                { "type": "initial", "maximumWarning": "1MB", "maximumError": "2MB" },
                { "type": "anyComponentStyle", "maximumWarning": "4kB", "maximumError": "8kB" }
              ],
              "outputHashing": "all",
              "optimization": { "scripts": true, "styles": true, "fonts": false }
            },
            "professional": {
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.prod.ts" },
                { "replace": "src/environments/edition.ts", "with": "src/environments/edition.professional.ts" }
              ],
              "budgets": [
                { "type": "initial", "maximumWarning": "1MB", "maximumError": "2MB" },
                { "type": "anyComponentStyle", "maximumWarning": "4kB", "maximumError": "8kB" }
              ],
              "outputHashing": "all",
              "optimization": { "scripts": true, "styles": true, "fonts": false }
            },
            "enterprise": {
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.prod.ts" },
                { "replace": "src/environments/edition.ts", "with": "src/environments/edition.enterprise.ts" }
              ],
              "budgets": [
                { "type": "initial", "maximumWarning": "1MB", "maximumError": "2MB" },
                { "type": "anyComponentStyle", "maximumWarning": "4kB", "maximumError": "8kB" }
              ],
              "outputHashing": "all",
              "optimization": { "scripts": true, "styles": true, "fonts": false }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "development-community": {
              "fileReplacements": [
                { "replace": "src/environments/edition.ts", "with": "src/environments/edition.community.ts" }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "development-professional": {
              "fileReplacements": [
                { "replace": "src/environments/edition.ts", "with": "src/environments/edition.professional.ts" }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "development-enterprise": {
              "fileReplacements": [
                { "replace": "src/environments/edition.ts", "with": "src/environments/edition.enterprise.ts" }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 5000,
            "host": "0.0.0.0",
            "allowedHosts": true
          },
          "configurations": {
            "production": {
              "buildTarget": "post-on-steroids:build:production"
            },
            "development": {
              "buildTarget": "post-on-steroids:build:development"
            },
            "community": {
              "buildTarget": "post-on-steroids:build:development-community"
            },
            "professional": {
              "buildTarget": "post-on-steroids:build:development-professional"
            },
            "enterprise": {
              "buildTarget": "post-on-steroids:build:development-enterprise"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
