{
  "appId": "com.papicnation.onsteroid",
  "productName": "OnSteroid",
  "directories": {
    "output": "release/"
  },
  "files": [
    "main.js",
    "package.json",
    "dist/post-on-steroids/browser/**/*"
  ],
  "win": {
    "target": ["nsis"],
    "icon": "public/icons/onsteroids-icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  }
}
