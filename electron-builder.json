{
  "appId": "com.papicnation.onsteroid",
  "productName": "OnSteroid",
  "publish": [
    {
      "provider": "generic",
      "url": "https://onsteroid.com/"
    }
  ],
  "directories": {
    "output": "release/"
  },
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "dist/post-on-steroids/browser/**/*"
  ],
  "win": {
    "target": ["nsis"],
    "icon": "public/icons/onsteroids-icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "public/icons/onsteroids-icon-512.png",
    "category": "public.app-category.developer-tools"
  },
  "linux": {
    "target": ["tar.gz", "zip"],
    "maintainer": "Papic Nation <support@onsteroid.com>",
    "icon": "public/icons/onsteroids-icon-512.png",
    "category": "Development"
  }
}
